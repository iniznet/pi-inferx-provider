{
  "name": "pi-inferx-provider",
  "version": "1.0.0",
  "description": "InferX provider extension for pi - Access DeepSeek, GLM, Qwen, Gemma, GPT-OSS, Devstral and Agents-A1 models through InferX serverless inference endpoints",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "models.json",
    "deprecated-models.json",
    "patch.json",
    "custom-models.json",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs scripts/test-model-resolution.ts",
    "update-models": "node scripts/update-models.js"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "inferx",
    "inferx-net",
    "ai",
    "llm",
    "serverless",
    "vllm",
    "deepseek",
    "glm",
    "qwen",
    "gemma",
    "gpt-oss",
    "devstral"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
